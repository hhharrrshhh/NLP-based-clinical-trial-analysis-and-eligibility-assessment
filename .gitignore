data/index/
data/raw/*

# Explicitly reviewed public API snapshot and official schema, with provenance.
# New raw runs remain ignored until separately reviewed for publication.
!data/raw/clinicaltrials/
data/raw/clinicaltrials/*
!data/raw/clinicaltrials/20261017T083822512361Z/
!data/raw/reference/
data/raw/reference/*
!data/raw/reference/clinicaltrials-v2-openapi.yaml

# Runtime decisions/databases are machine-local, not public research fixtures.
*.sqlite*
*.db
*.db-journal

# Generated archives, process state, local guide extraction and transient files.
storage/
tmp/
temp/
reports/tmp/
reports/cache/
reports/server*.json
reports/source_archive.json
docs/source_guide.txt
*.zip
*.7z
*.rar
.ipynb_checkpoints/

