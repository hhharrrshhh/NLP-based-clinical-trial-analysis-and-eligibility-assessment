# Set environment variables before running locally; Compose reads this file after copying to .env.
API_BASE_URL=http://127.0.0.1:8000
DATA_DIR=data
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
HF_HOME=models/hf
# Local FLAN-T5-small is used only when a generated draft is requested.
GENERATOR_BACKEND=local
# Optional alternative: GENERATOR_BACKEND=ollama and an installed Ollama model.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
TOKENIZERS_PARALLELISM=false

